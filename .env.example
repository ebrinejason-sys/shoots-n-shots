# Copy to .env and adjust. Everything below has a working development default
# except the Flutterwave and delivery-provider credentials.

# --- Database -----------------------------------------------------------------
# Local development (docker compose up -d):
DATABASE_URL=postgres://sns:sns_dev_password@localhost:5432/sns_tickets

# Supabase Cloud — Project settings → Database → Connection string.
# The app uses the *pooler* (transaction mode) string on port 6543:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Running DDL through the pooler is unreliable, so `npm run db:setup` should use
# the *direct* string on port 5432 — run it with DATABASE_URL overridden:
#   DATABASE_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres" npm run db:setup
# TLS turns on automatically for any non-local host. Set DATABASE_SSL=true to
# force it, or DATABASE_SSL_CA to a PEM bundle to verify the server certificate.
DATABASE_SSL=
DATABASE_SSL_CA=

# Public origin used for ticket links when no request context exists (webhooks,
# delivery). Set this to the deployed HTTPS origin in production.
APP_URL=http://localhost:3000

# --- Payments -----------------------------------------------------------------
# With MOCK_PAYMENTS=true the hosted checkout is bypassed and the payment page
# offers "approve"/"decline" buttons that run the same server-side confirmation
# path a real webhook would.
MOCK_PAYMENTS=true
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
# Dashboard → Settings → Webhooks → Secret hash (sent back as `verif-hash`).
FLUTTERWAVE_WEBHOOK_SECRET=
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com

# --- Staff --------------------------------------------------------------------
# Shared passcode for the scanner, admin and gate-sales screens.
STAFF_PASSCODE=staff1234
COOKIE_SECRET=dev-only-insecure-cookie-secret-change-me
TICKET_SECRET=dev-only-insecure-ticket-secret-change-me

# --- Delivery -----------------------------------------------------------------
# Channels in priority order: console, whatsapp, sms, email. The customer's
# email is where the QR code is delivered, so keep `email` in the list.
DELIVERY_CHANNELS=console,email

# WhatsApp Cloud API (optional)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=

# Africa's Talking SMS (optional)
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# Resend email — the QR is attached inline, so no public image URL is needed.
RESEND_API_KEY=
EMAIL_FROM=tickets@example.com
