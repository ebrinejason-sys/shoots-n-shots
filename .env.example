# Copy to .env and adjust. Everything below has a working development default
# except the Flutterwave and delivery-provider credentials.

DATABASE_URL=postgres://sns:sns_dev_password@localhost:5432/sns_tickets
APP_URL=http://localhost:3000

# Payment. With MOCK_PAYMENTS=true the hosted checkout is bypassed and the
# payment page offers "approve"/"decline" buttons that run the same server-side
# confirmation path a real webhook would.
MOCK_PAYMENTS=true
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com

# Shared passcode for the scanner and admin screens.
STAFF_PASSCODE=staff1234
COOKIE_SECRET=dev-only-insecure-cookie-secret-change-me
TICKET_SECRET=dev-only-insecure-ticket-secret-change-me

# Delivery channels in priority order: console, whatsapp, sms, email
DELIVERY_CHANNELS=console

# WhatsApp Cloud API (optional)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=

# Africa's Talking SMS (optional)
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# Resend email (optional)
RESEND_API_KEY=
EMAIL_FROM=tickets@example.com
